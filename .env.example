# Local synthetic demo only. Tool credentials are issued into the database with
# `clinic-voice credential issue`; they are not configured here.
DATABASE_URL=postgresql://clinic:clinic_local_only@localhost:55432/clinic_voice
# External providers are deliberately unconfigured. Never put credentials in agent JSON.
# Google Calendar (optional; owner setup in docs/OPERATIONS.md). Leave unset to keep the
# calendar endpoints disabled (503). Real values belong in .env or a secret manager only.
# TOKEN_ENCRYPTION_KEYS=k1:<output of clinic-voice generate-key>
# PHONE_HASH_KEY=<output of clinic-voice generate-key>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/v1/oauth/google/callback
# Bolna gateway: needs TOKEN_ENCRYPTION_KEYS and PHONE_HASH_KEY above (503 otherwise).
# BOLNA_GATEWAY_BASE_URL=https://voice.clinic.example  # used by `clinic-voice bolna compile-agent`
# BOLNA_API_KEY=  # read by nothing yet; provisioning is planned (owner authorization required)
