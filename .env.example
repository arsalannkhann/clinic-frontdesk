# Local synthetic development only. Copy to .env (untracked) and adjust. Every setting read
# by src/clinic_voice/config.py is listed here; commented-out lines show the default or an
# example and are not set. No real secret belongs in this file or in Git: generate keys with
# `clinic-voice generate-key` and keep them in .env or a secret manager.
#
# Tool, Bolna gateway and webhook credentials are database records issued with
# `clinic-voice credential issue` (scopes tools, bolna, webhook); they are not configured here.

# PostgreSQL URL (required). The Compose database's local-only password; the `_dev` suffix
# marks a development database, which is what allows the worker's fake ports
# (--calendar/--bolna/--messaging fake). Create it once:
#   docker compose exec db createdb -U clinic clinic_voice_dev
DATABASE_URL=postgresql://clinic:clinic_local_only@localhost:55432/clinic_voice_dev

# "development" also allows the fake worker ports on a database without a _test/_dev suffix.
# Any other value (default "production") keeps them refused. Do not set it in production.
# APP_ENV=production

# --- Encryption keys (no defaults; required by the Bolna gateway and Google Calendar) ---
# Keyring for OAuth refresh tokens, call-session caller numbers and patient fields:
# "kid:<base64 32 bytes>", comma-separated; the first key encrypts, all decrypt. Rotation:
# prepend a new key and keep old ones while rows reference them (docs/OPERATIONS.md).
# TOKEN_ENCRYPTION_KEYS=k1:<output of clinic-voice generate-key>
# HMAC key for caller/patient phone hashes (bare base64 32 bytes, no kid). Not casually
# rotatable: existing hashes stop matching, which breaks booking verification.
# PHONE_HASH_KEY=<output of clinic-voice generate-key>

# --- Retention (`clinic-voice retention purge`, operator-run; nothing schedules it) ---
# Days after a patient's latest appointment start before the patient record is purged (1-3650).
# PATIENT_RETENTION_DAYS=365
# Days before call sessions (encrypted caller number, verification state) are purged (1-3650).
# CALL_SESSION_RETENTION_DAYS=90

# --- Google Calendar (optional; owner setup in docs/OPERATIONS.md) ---
# Unset: the calendar endpoints return 503 and `worker --calendar google` refuses to start.
# Needs TOKEN_ENCRYPTION_KEYS too. The redirect URI must be https, or http on loopback only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/v1/oauth/google/callback

# --- Bolna ---
# Bolna platform API key, read only by the worker with `--bolna live` (call reconciliation,
# reminder calls and stops, provisioning agent/number steps). The gateway routes Bolna calls do
# not use it. Live use needs explicit owner authorization (docs/CLAUDE_HANDOFF.md).
# BOLNA_API_KEY=
# Bolna platform API base URL (https; http only on loopback for tests).
# BOLNA_API_BASE=https://api.bolna.ai
# Public https base URL of this API as Bolna reaches it; the agent compiler and provisioning
# build tool URLs from it. Unset: compile-agent needs --gateway-url and the provisioning agent
# step fails with gateway_unconfigured.
# BOLNA_GATEWAY_BASE_URL=https://voice.clinic.example

# --- Bolna execution webhooks (POST /v1/webhooks/bolna/{token}) ---
# Largest accepted webhook body in bytes (1024-1048576); larger requests get 413.
# WEBHOOK_MAX_BODY_BYTES=65536
# Optional source allowlist (comma-separated IPs or CIDR networks), defense in depth only.
# Unset: any source. Recheck Bolna's published addresses before setting it.
# BOLNA_WEBHOOK_ALLOWED_IPS=
# Reverse proxies in front of the API that append to X-Forwarded-For (0-5). 0: the socket peer
# is the client and X-Forwarded-For is ignored. With >0 the API must not be reachable directly.
# TRUSTED_PROXY_HOPS=0
# Reconciliation: poll a call session without a final status this many minutes after its start
# or last provider update (1-1440; doubles after each poll), at most BOLNA_RECONCILE_BATCH
# sessions per housekeeping pass (1-1000). Only workers with --bolna reconcile.
# BOLNA_RECONCILE_AFTER_MINUTES=30
# BOLNA_RECONCILE_BATCH=50

# --- Staff dashboard ---
# Exact browser origins allowed to call /v1/staff/* and /v1/admin/* cross-origin
# (comma-separated; https, or http on loopback; no wildcards or paths). Unset: no CORS headers
# (serve the dashboard same-origin or use the Vite dev proxy). The dashboard's own build
# settings (VITE_API_BASE_URL, DASHBOARD_API_PROXY_TARGET) are described in dashboard/README.md.
# DASHBOARD_ORIGINS=http://127.0.0.1:5173

# --- Database pooling (read by db.connect from the process environment, not from .env) ---
# transaction: a transaction-mode pooler (Supabase pooler port 6543, PgBouncer transaction
# mode); psycopg prepared statements are then disabled. session or none: keep them. Unset:
# transaction pooling is assumed exactly when the DATABASE_URL port is 6543.
# DATABASE_POOLER=transaction

# --- Serverless worker tick (POST /v1/internal/worker/tick) ---
# Bearer secret (at least 32 characters) the scheduler sends. Unset: the endpoint answers 404.
# WORKER_TICK_SECRET=<output of clinic-voice generate-key>
# Seconds a tick runs outbox jobs before housekeeping (1-50); keep under vercel.json maxDuration.
# WORKER_TICK_BUDGET_SECONDS=8
# Seconds a public booking waits for its own ledger calendar confirmation (0-10; 0: never inline).
# INLINE_CONFIRM_BUDGET_SECONDS=3

# --- Public clinic API (/v1/public/clinics/{slug}/...) ---
# Needs TOKEN_ENCRYPTION_KEYS and PHONE_HASH_KEY for bookings, lookups and callbacks (503
# otherwise). Fixed-window limits: per client address (TRUSTED_PROXY_HOPS decides the address)
# and per phone.
# PUBLIC_BOOKING_IP_PER_HOUR=5
# PUBLIC_BOOKING_PHONE_PER_DAY=3
# PUBLIC_LOOKUP_IP_PER_HOUR=10
# PUBLIC_CALLBACK_IP_PER_HOUR=3
# PUBLIC_CALLBACK_PHONE_PER_DAY=3
# Per-phone daily limit on booking lookups (per clinic), and per-address hourly limits on the
# slot search and the catalogue reads (profile, services, doctors).
# PUBLIC_LOOKUP_PHONE_PER_DAY=10
# PUBLIC_SLOTS_IP_PER_HOUR=120
# PUBLIC_READ_IP_PER_HOUR=600
# Shared secret (at least 32 characters) the web BFF sends as X-Proxy-Secret on every
# /v1/public/* and /v1/chat/* request. Set: requests without it are 403 forbidden, and the
# client address is taken from the BFF's single X-Client-IP header (X-Forwarded-For and
# TRUSTED_PROXY_HOPS are then ignored on these paths). Unset: no check (development only).
# PUBLIC_PROXY_SECRET=<output of clinic-voice generate-key>

# --- Chat assistant (/v1/chat/*, ADR 0011) ---
# OpenAI-compatible chat completions endpoint (https, or http on loopback). Defaults: Sarvam.
# Without CHAT_LLM_API_KEY the assistant answers with quick replies and the fallback text
# (book online, request a callback, call the clinic) and never calls a model.
# CHAT_LLM_BASE_URL=https://api.sarvam.ai/v1
# CHAT_LLM_MODEL=sarvam-105b
# CHAT_LLM_API_KEY=
# Header carrying the key: api-subscription-key (Sarvam) or authorization (Bearer <key>).
# CHAT_LLM_AUTH_HEADER=api-subscription-key
# CHAT_LLM_TIMEOUT_SECONDS=25
# CHAT_LLM_MAX_TOKENS=1500
# Patient messages per conversation, and per-address hourly limits on new conversations and
# messages.
# CHAT_MAX_TURNS=40
# CHAT_SESSION_IP_PER_HOUR=10
# CHAT_MESSAGE_IP_PER_HOUR=120
