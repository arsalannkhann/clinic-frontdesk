  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PasswordChange": {
        "properties": {
          "current_password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Current Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "title": "New Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChange"
      },
      "ReservationRequest": {
        "properties": {
          "doctor_id": {
            "type": "string",
            "format": "uuid",
            "title": "Doctor Id"
          },
          "service_id": {
            "type": "string",
            "format": "uuid",
            "title": "Service Id"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "title": "Starts At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "doctor_id",
          "service_id",
          "starts_at"
        ],
        "title": "ReservationRequest"
      },
      "ReservationResponse": {
        "properties": {
          "appointment_id": {
            "type": "string",
            "format": "uuid",
            "title": "Appointment Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "title": "Starts At"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ends At"
          },
          "spoken_confirmation": {
            "type": "string",
            "title": "Spoken Confirmation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "appointment_id",
          "status",
          "starts_at",
          "ends_at",
          "spoken_confirmation"
        ],
        "title": "ReservationResponse"
      },
      "SessionResponse": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "user": {
            "$ref": "#/components/schemas/StaffUser"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token",
          "expires_at",
          "user"
        ],
        "title": "SessionResponse"
      },
      "SlotQuery": {
        "properties": {
          "doctor_id": {
            "type": "string",
            "format": "uuid",
            "title": "Doctor Id"
          },
          "service_id": {
            "type": "string",
            "format": "uuid",
            "title": "Service Id"
          },
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "doctor_id",
          "service_id",
          "day"
        ],
        "title": "SlotQuery"
      },
      "SlotResponse": {
        "properties": {
          "slots": {
            "items": {
              "type": "string",
              "format": "date-time"
            },
            "type": "array",
            "title": "Slots"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "local_reservations_only"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SlotResponse"
      },
      "StaffUser": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "viewer"
            ],
            "title": "Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "email",
          "role"
        ],
        "title": "StaffUser"
      },
      "StaffUserCreate": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "viewer"
            ],
            "title": "Role"
          },
          "temporary_password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "title": "Temporary Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "role",
          "temporary_password"
        ],
        "title": "StaffUserCreate"
      },
      "StaffUserDetail": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "viewer"
            ],
            "title": "Role"
          },
          "disabled": {
            "type": "boolean",
            "title": "Disabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "email",
          "role",
          "disabled"
        ],
        "title": "StaffUserDetail"
      },
      "StaffUserUpdate": {
        "properties": {
          "role": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "owner",
                  "admin",
                  "viewer"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "disabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disabled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "StaffUserUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
