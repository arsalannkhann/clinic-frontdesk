# Base URL of the Clinic Voice API, without a trailing slash. Leave empty to call the API on
# the dashboard's own origin (same-origin deployment, or the Vite dev-server proxy below).
VITE_API_BASE_URL=
# Dev server only: where the Vite proxy forwards /v1 when VITE_API_BASE_URL is empty.
DASHBOARD_API_PROXY_TARGET=http://127.0.0.1:8000
