# Server-only. The FastAPI origin without a trailing slash,
# e.g. https://clinic-platform-api.vercel.app
# Leave unset in development to run against the built-in mock fixtures. A production server
# without it refuses to start, and every API route answers 500 misconfigured.
API_BASE_URL=

# The public clinic this site serves (the API's clinics.public_slug).
CLINIC_SLUG=aster-dental

# Canonical public origin, used for metadata, the sitemap and the CSRF same-origin check.
SITE_URL=http://localhost:3000

# Upstream timeouts in milliseconds (optional).
API_TIMEOUT_MS=10000
CHAT_TIMEOUT_MS=25000
